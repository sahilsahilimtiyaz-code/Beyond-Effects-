<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/be_pref_cat_playback">
    <SwitchPreference android:title="@string/show_watermark_on_projects" android:key="com.alightcreative.motion.watermark" android:summary="@string/show_watermark_on_projects_detail" android:defaultValue="true" android:singleLineTitle="false" />
    <SwitchPreference android:title="@string/pref_low_quality_preview_title" android:key="com.alightcreative.motion.lowQualityPreview" android:summary="@string/pref_low_quality_preview_detail" android:defaultValue="true" android:singleLineTitle="false" />
    <ListPreference android:entries="@array/timelineHeaderThumbBoundsLabels" android:title="@string/thumbnail_bounds" android:key="com.alightcreative.motion.thumbBounds" android:summary="@string/thumbnail_bounds_summary" android:defaultValue="element" android:entryValues="@array/timelineHeaderThumbBoundsValues" android:singleLineTitle="false" />
    <ListPreference android:entries="@array/recentlyUsedVisualMedia" android:title="@string/mini_browser_recent_media" android:key="com.alightcreative.motion.recentMediaSize" android:summary="%s" android:defaultValue="0" android:entryValues="@array/recentlyUsedVisualMediaValues" android:singleLineTitle="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/be_pref_cat_editing">
    <SwitchPreference android:title="@string/enhanced_controlpad_precision" android:key="com.alightcreative.motion.controlpadAccel" android:summary="@string/enhanced_controlpad_precision_detail" android:defaultValue="false" android:singleLineTitle="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/be_pref_cat_appearance">
    <SwitchPreference android:title="@string/desaturated_ui_theme" android:key="com.alightcreative.motion.grayTheme" android:summary="@string/desaturated_ui_theme_detail" android:defaultValue="false" android:singleLineTitle="false" />
    <Preference android:title="@string/clear_export_cache" android:key="com.alightcreative.motion.prefbutton.clearExportCache" android:summary="(Currently 0MB)" android:singleLineTitle="false" />
    </PreferenceCategory>
</PreferenceScreen>
