<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33ffffff">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#ff6fd4f8" android:endColor="#ff6e8cf8" />
                </shape>
            </item>
            <item android:left="1.5dp" android:top="1.1dp" android:right="1.5dp" android:bottom="1.1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#6630404f" android:endColor="#4d1e2a3a" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
