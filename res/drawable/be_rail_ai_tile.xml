<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. light lavender glass border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14.0dp" />
            <solid android:color="#99cfcbe8" />
        </shape>
    </item>
    <!-- 2. inner glass -->
    <item android:left="1.2dp" android:top="1.2dp" android:right="1.2dp" android:bottom="1.2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12.8dp" />
            <solid android:color="#2effffff" />
        </shape>
    </item>
    <!-- 3. blue glow around the sparkle -->
    <item android:left="1.2dp" android:top="1.2dp" android:right="1.2dp" android:bottom="1.2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12.8dp" />
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0.55" android:gradientRadius="30.0dp" android:startColor="#4d6fa8ff" android:endColor="#006fa8ff" />
        </shape>
    </item>
    <!-- 4. top sheen -->
    <item android:left="1.2dp" android:top="1.2dp" android:right="1.2dp" android:bottom="1.2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12.8dp" />
            <gradient android:angle="270">
                <item android:offset="0.0" android:color="#33ffffff" />
                <item android:offset="0.5" android:color="#00ffffff" />
            </gradient>
        </shape>
    </item>
</layer-list>
