<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1d2030" />
            <corners android:radius="18.0dp" />
            <stroke android:width="1.0dp" android:color="#323852" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151720" />
            <corners android:radius="18.0dp" />
            <stroke android:width="1.0dp" android:color="#262b3a" />
        </shape>
    </item>
</selector>
