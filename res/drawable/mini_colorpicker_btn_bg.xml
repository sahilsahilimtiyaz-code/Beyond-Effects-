<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false" android:state_activated="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/S10" />
        </shape>
    </item>
    <item android:state_pressed="true" android:state_activated="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/A11" />
        </shape>
    </item>
    <item android:state_pressed="false" android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/A11" />
        </shape>
    </item>
</selector>
