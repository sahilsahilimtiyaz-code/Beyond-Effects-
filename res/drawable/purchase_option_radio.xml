<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/Y1" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="4.5dp" android:color="@color/HT" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="@color/HT" />
        </shape>
    </item>
</selector>
