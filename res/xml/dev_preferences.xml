    <PreferenceCategory android:layout="@layout/dev_pref_header" android:title="Beyond Effects Customization" app:iconSpaceReserved="false">
        <Preference android:title="Customize Beyond Effects" android:summary="Pick theme, timeline and home colours, customize the homepage title/subtitle, or replace the homepage logo area with your own photo. The original logo colours stay unchanged." app:iconSpaceReserved="false">
            <intent android:targetPackage="com.octavian" android:targetClass="com.goldmotion.customize.CustomizationActivity" />
        </Preference>
