        <EditTextPreference android:title="Firebase Emulator Address" android:key="com.alightcreative.motion.firebaseEmulatorAddress" android:defaultValue="" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true" />
        <Preference android:title="Add 3.5 to installed version history" android:key="com.alightcreative.motion.action.addInstall3_5" app:iconSpaceReserved="false" />
