    <PreferenceCategory android:layout="@layout/dev_pref_header" android:title="Mod Advanced" app:iconSpaceReserved="false">
        <SwitchPreference android:enabled="false" android:title="Bypass Project Export" android:summary="Allows this mod function to export project packages to the server" android:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreference android:enabled="false" android:title="Remove Paywall Screen" android:summary="Allows this mod to remove the paywall screen that always appears on the homepage and edit projects" android:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreference android:title="Fake Dark Mode" android:key="com.alightcreative.motion.fakeDarkMode" android:summary="Forces a dark UI look manually (experimental override)" android:defaultValue="false" android:singleLineTitle="false" app:iconSpaceReserved="false" />
