        </PreferenceCategory>
        <SwitchPreference android:enabled="false" android:title="@string/show_watermark_on_projects" android:summary="Watermark disabled by octavian" android:defaultValue="false" android:singleLineTitle="false" app:iconSpaceReserved="false" />
