        <Preference android:title="Device Diagnostic Information" android:key="com.alightcretive.motion.showDiagnosticInfo" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:layout="@layout/dev_pref_header" android:title="Testing" android:key="header.com.alightcreative.motion.testing" app:iconSpaceReserved="false">
