                <ListPreference android:entries="@array/effectStrengthLabels" android:title="Effect Strength" android:key="com.mod.menu.effectStrength" android:summary="%s" android:defaultValue="medium" android:entryValues="@array/effectStrengthValues" app:iconSpaceReserved="false" />
