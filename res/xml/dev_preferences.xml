        <ListPreference android:entries="@array/accountTestModeLabels" android:title="Sign-in Simulation" android:key="com.alightcreative.motion.acctTestMode" android:summary="%s" android:defaultValue="normal" android:entryValues="@array/accountTestModeValues" app:iconSpaceReserved="false" />
        <SwitchPreference android:title="Pass Testing" android:key="com.alightcreative.motion.iaptest" android:summary="Treat annual passes as hourly passes, monthly passes as annual passes" android:defaultValue="false" app:iconSpaceReserved="false" />
