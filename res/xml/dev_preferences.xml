    <PreferenceCategory android:layout="@layout/dev_pref_header" android:title="General" android:key="header.com.alightcreative.motion.acDevMode" app:iconSpaceReserved="false">
        <SwitchPreference android:title="Developer Testing Override" android:key="com.alightcreative.motion.acDevMode" android:defaultValue="false" app:iconSpaceReserved="false" />
        <SwitchPreference android:title="Demo Mode" android:key="com.alightcreative.motion.demoMode" android:defaultValue="false" app:iconSpaceReserved="false" />
